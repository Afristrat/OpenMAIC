{
  "id": "kpi-dashboard",
  "type": "kpi-dashboard",
  "name": { "fr": "Tableau de bord KPI", "ar": "لوحة مؤشرات الأداء", "en": "KPI dashboard" },
  "description": {
    "fr": "Reliez des indicateurs à leurs objectifs et repérez immédiatement les écarts qui méritent une investigation.",
    "ar": "اربط المؤشرات بأهدافها وحدد فوراً الفجوات التي تتطلب التحليل.",
    "en": "Connect indicators to targets and immediately spot gaps that require investigation."
  },
  "displayType": { "fr": "Tableau de pilotage", "ar": "لوحة قيادة", "en": "Performance dashboard" },
  "version": "1.0.0",
  "author": "Qalem",
  "renderUrl": "index.html",
  "icon": "Gauge",
  "systemPrompt": "",
  "outputSchema": {
    "type": "object",
    "properties": {
      "title": { "type": "string" },
      "instructions": { "type": "string" },
      "metrics": {
        "type": "array",
        "minItems": 3,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "current": { "type": "number" },
            "target": { "type": "number" },
            "direction": { "type": "string", "enum": ["higher", "lower"] },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "unit": { "type": "string" }
          },
          "required": ["label", "current", "target", "direction"]
        }
      },
      "labels": {
        "type": "object",
        "properties": { "dashboard": { "type": "string" } },
        "required": ["dashboard"]
      }
    },
    "required": ["title", "instructions", "metrics", "labels"]
  },
  "supportedActions": ["change-kpi", "inspect-gap"],
  "demoData": {
    "eyebrow": "Lecture de performance",
    "title": "Quels écarts exigent une investigation avant d’agir ?",
    "instructions": "Modifiez les valeurs observées et comparez-les aux objectifs. Un écart est un point de départ pour questionner les causes.",
    "metrics": [
      {
        "label": "Taux de conversion",
        "current": 8.5,
        "target": 12,
        "direction": "higher",
        "min": 0,
        "max": 100,
        "step": 0.5,
        "unit": "%"
      },
      {
        "label": "Délai moyen de livraison",
        "current": 2.4,
        "target": 2,
        "direction": "lower",
        "min": 0,
        "max": 20,
        "step": 0.1,
        "unit": "jours"
      },
      {
        "label": "Satisfaction client",
        "current": 82,
        "target": 90,
        "direction": "higher",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%"
      },
      {
        "label": "Marge brute",
        "current": 31,
        "target": 35,
        "direction": "higher",
        "min": -100,
        "max": 100,
        "step": 1,
        "unit": "%"
      }
    ],
    "labels": { "dashboard": "État des indicateurs" }
  }
}
