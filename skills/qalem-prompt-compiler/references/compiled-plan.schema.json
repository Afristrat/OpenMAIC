{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QalemCompiledGenerationPlan",
  "type": "object",
  "required": ["status", "contract", "assumptions", "blockingQuestions", "tasks"],
  "properties": {
    "status": { "enum": ["ready", "needs_input", "uncertified"] },
    "contract": { "type": "object" },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "value", "evidence", "confidence"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "value": {},
          "evidence": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "blockingQuestions": { "type": "array", "items": { "type": "string" } },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capability", "locale", "model", "fallback", "prompt", "evaluations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capability": { "type": "string", "minLength": 1 },
          "locale": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "fallback": { "type": ["string", "null"] },
          "prompt": {
            "type": "object",
            "required": ["strategy", "systemInstructions", "untrustedInput", "response"],
            "properties": {
              "strategy": {
                "enum": [
                  "direct",
                  "structured-output",
                  "reasoning-structured-output",
                  "multimodal-analysis",
                  "workflow-parameters"
                ]
              },
              "systemInstructions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "untrustedInput": { "type": "object" },
              "response": { "type": "object" }
            }
          },
          "outputSchema": { "type": ["object", "null"] },
          "evaluations": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
