{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qalem.ma/schemas/formation-engine-publication-plan.schema.json",
  "title": "Formation Engine Publication Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standalone", "qalem"],
      "properties": {
        "standalone": { "$ref": "#/$defs/target" },
        "qalem": { "$ref": "#/$defs/target" }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redistributionApproval", "files"],
      "properties": {
        "redistributionApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reference"],
          "properties": {
            "status": { "const": "approved" },
            "reference": { "type": "string", "minLength": 1 }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
