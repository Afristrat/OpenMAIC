{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalem Local",
  "version": "0.1.0",
  "identifier": "ma.qalem.local",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Qalem Local",
        "width": 900,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src https://qalem.ma; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
